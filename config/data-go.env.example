# Use the general authentication key (Decoding) issued by data.go.kr.
# Do not commit a real API key.
DATA_GO_API_KEY=replace-with-your-data-go-kr-api-key

# Separate key issued by Food Safety Korea / MFDS data service.
# Keep this empty until you have applied for the required services.
FOOD_SAFETY_API_KEY=replace-with-your-food-safety-korea-api-key
