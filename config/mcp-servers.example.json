{
  "name": "mcp-platform",
  "servers": [
    {
      "id": "corporate_intelligence",
      "label": "Corporate Intelligence Hub",
      "transport": "stdio",
      "command": "/bin/bash",
      "args": ["scripts/run-corporate-intelligence.sh"],
      "envPassthrough": ["DATA_GO_API_KEY", "API_KEY", "RAG_VLLM_URL", "RAG_API_KEY"],
      "readOnlyTools": ["analyze_company_comprehensive"]
    },
    {
      "id": "internal_rag",
      "label": "Internal RAG-vLLM Knowledge Hub",
      "transport": "stdio",
      "command": "/bin/bash",
      "args": ["scripts/run-internal-rag.sh"],
      "envPassthrough": ["RAG_VLLM_URL", "RAG_API_KEY"],
      "allowWriteTools": false,
      "readOnlyTools": [
        "rag_search_documents",
        "rag_ask_ai",
        "rag_list_documents",
        "rag_get_document_detail"
      ]
    },
    {
      "id": "moe_dq_quality",
      "label": "MOE Data Quality API",
      "transport": "stdio",
      "command": "/bin/bash",
      "args": ["scripts/run-moe-dq-quality.sh"],
      "envPassthrough": ["MOE_DQ_DIAG_API_BASE_URL"],
      "allowWriteTools": true,
      "enabledTools": [
        "get_quality_api_capabilities",
        "get_quality_catalog_summary",
        "list_quality_catalog_rules",
        "get_quality_catalog_rule",
        "diagnose_unstructured_text",
        "rediagnose_text_pair",
        "submit_unstructured_text_job",
        "get_unstructured_text_job_status"
      ],
      "readOnlyTools": [
        "get_quality_api_capabilities",
        "get_quality_catalog_summary",
        "list_quality_catalog_rules",
        "get_quality_catalog_rule",
        "diagnose_unstructured_text",
        "rediagnose_text_pair",
        "get_unstructured_text_job_status"
      ],
      "requestTimeoutMs": 120000
    },
    {
      "id": "playwright",
      "label": "Playwright browser automation",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "--yes",
        "@playwright/mcp@0.0.83",
        "--headless",
        "--browser",
        "chromium",
        "--isolated",
        "--allowed-origins",
        "http://127.0.0.1:20085;http://localhost:20085;http://127.0.0.1:3006;http://localhost:3006"
      ],
      "cwd": "../moe_dq_diag",
      "allowWriteTools": true,
      "enabledTools": [
        "browser_navigate",
        "browser_navigate_back",
        "browser_click",
        "browser_fill_form",
        "browser_type",
        "browser_select_option",
        "browser_wait_for",
        "browser_snapshot",
        "browser_find",
        "browser_take_screenshot",
        "browser_console_messages",
        "browser_file_upload"
      ],
      "readOnlyTools": [
        "browser_snapshot",
        "browser_find",
        "browser_take_screenshot",
        "browser_console_messages"
      ],
      "requestTimeoutMs": 120000
    },
    {
      "id": "rea_dev",
      "label": "REA web, JavaScript and Electron analysis",
      "transport": "stdio",
      "command": "npx",
      "args": ["--yes", "rea-agents@6.4.0", "mcp"],
      "cwd": "../moe_dq_diag",
      "enabledTools": [
        "list_browser_targets",
        "inspect_web_page",
        "analyze_web_bundle",
        "discover_webmcp_tools",
        "trace_web_module_imports",
        "trace_web_source_location",
        "inspect_web_event_listeners",
        "inspect_web_network_capture",
        "observe_web_execution",
        "observe_web_session",
        "compare_web_captures",
        "capture_web_screenshot",
        "compare_web_screenshots",
        "list_electron_targets",
        "inspect_electron_page",
        "analyze_javascript_application",
        "reconcile_javascript_runtime",
        "list_javascript_runtime_targets",
        "observe_javascript_runtime",
        "trace_application_feature",
        "trace_javascript_semantics",
        "compare_application_versions",
        "compare_source_to_bundle",
        "compare_javascript_export_shapes",
        "build_reconstruction_obligation_ledger",
        "evaluate_reconstruction_coverage",
        "verify_reconstruction",
        "inspect_analysis_view"
      ],
      "allowWriteTools": true,
      "requestTimeoutMs": 120000
    },
    {
      "id": "internal_remote",
      "label": "Example remote MCP server",
      "enabled": false,
      "transport": "streamable-http",
      "url": "https://mcp.example.com/mcp",
      "headersFromEnv": {
        "Authorization": "MCP_REMOTE_BEARER_TOKEN"
      },
      "requestTimeoutMs": 60000
    },
    {
      "id": "data_go_pps",
      "label": "PPS Narajangteo",
      "transport": "stdio",
      "command": "/bin/bash",
      "args": ["scripts/run-data-go-pps.sh"],
      "envPassthrough": ["DATA_GO_API_KEY", "API_KEY"],
      "readOnlyTools": [
        "search_bid_announcements",
        "search_successful_bids",
        "search_contracts",
        "get_bid_detail",
        "search_order_plans"
      ]
    },
    {
      "id": "data_go_nps",
      "label": "NPS business enrollment",
      "transport": "stdio",
      "command": "/bin/bash",
      "args": ["scripts/run-data-go-nps.sh"],
      "envPassthrough": ["DATA_GO_API_KEY", "API_KEY"],
      "readOnlyTools": ["search_business", "get_business_detail", "get_period_status"]
    },
    {
      "id": "data_go_nts",
      "label": "NTS business verification",
      "transport": "stdio",
      "command": "/bin/bash",
      "args": ["scripts/run-data-go-nts.sh"],
      "envPassthrough": ["DATA_GO_API_KEY", "API_KEY"],
      "readOnlyTools": ["validate_business", "check_business_status", "batch_validate_businesses"]
    },
    {
      "id": "data_go_fsc",
      "label": "FSC financial information",
      "transport": "stdio",
      "command": "/bin/bash",
      "args": ["scripts/run-data-go-fsc.sh"],
      "envPassthrough": ["DATA_GO_API_KEY", "API_KEY"],
      "readOnlyTools": [
        "get_summary_financial_statement",
        "get_balance_sheet",
        "get_income_statement",
        "search_company_financial_info"
      ]
    },
    {
      "id": "data_go_catalog",
      "label": "Public Data Portal catalog",
      "transport": "stdio",
      "command": "/bin/bash",
      "args": ["scripts/run-data-go-catalog.sh"],
      "envPassthrough": ["DATA_GO_API_KEY", "API_KEY"],
      "readOnlyTools": ["search_public_datasets"]
    },
    {
      "id": "food_safety",
      "label": "Food Safety Korea",
      "transport": "stdio",
      "command": "/bin/bash",
      "args": ["scripts/run-data-go-food-safety.sh"],
      "envPassthrough": ["FOOD_SAFETY_API_KEY", "FOOD_API_KEY"],
      "readOnlyTools": [
        "search_food_products",
        "search_food_manufacturing_reports",
        "search_recalled_foods"
      ]
    },
    {
      "id": "dart_filings",
      "label": "OpenDART Corporate Disclosures",
      "transport": "stdio",
      "command": "/bin/bash",
      "args": ["scripts/run-dart-filings.sh"],
      "envPassthrough": ["DART_API_KEY", "DATA_GO_API_KEY"],
      "readOnlyTools": ["search_dart_filings", "get_company_overview"]
    },
    {
      "id": "address_lookup",
      "label": "Address and District Standard Lookup",
      "transport": "stdio",
      "command": "/bin/bash",
      "args": ["scripts/run-address-lookup.sh"],
      "envPassthrough": ["JUSO_API_KEY", "DATA_GO_API_KEY"],
      "readOnlyTools": ["search_address", "get_administrative_district"]
    },
    {
      "id": "smes_programs",
      "label": "SMES Support Programs and Policy Funds",
      "transport": "stdio",
      "command": "/bin/bash",
      "args": ["scripts/run-smes-programs.sh"],
      "envPassthrough": ["BIZINFO_API_KEY", "DATA_GO_API_KEY"],
      "readOnlyTools": ["search_support_programs", "get_support_program_detail"]
    },
    {
      "id": "kipris_patents",
      "label": "KIPRIS Patent and Utility Model Information",
      "transport": "stdio",
      "command": "/bin/bash",
      "args": ["scripts/run-kipris-patents.sh"],
      "envPassthrough": ["KIPRIS_API_KEY", "DATA_GO_API_KEY"],
      "readOnlyTools": ["search_patents", "get_patent_detail"]
    },
    {
      "id": "go_runtime",
      "label": "Go High-Performance Batch Runtime",
      "transport": "stdio",
      "command": "/bin/bash",
      "args": ["scripts/run-mcp-go-server.sh"],
      "allowWriteTools": false,
      "readOnlyTools": [
        "greet",
        "health_ping",
        "system_metrics",
        "batch_collect_bids",
        "batch_validate_corporate",
        "benchmark_parallel_collector"
      ]
    }
  ]
}
