{
  "mcpServers": {
    "mcp-platform": {
      "command": "/bin/bash",
      "args": [
        "__MCP_PLATFORM_ROOT__/scripts/run-mcp-gateway.sh"
      ]
    },
    "workspace-tools": {
      "command": "node",
      "args": [
        "__MCP_PLATFORM_ROOT__/dist/servers/workspace-tools.js"
      ],
      "env": {
        "MCP_WORKSPACE_ROOT": "__WORKSPACE_ROOT__"
      }
    }
  }
}
